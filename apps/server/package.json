{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "preview:test": "node --require tsx/cjs src/testing/previewServer.ts",
    "build": "tsc",
    "start": "node dist/apps/server/src/index.js",
    "lint": "eslint src",
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "test": "node --require tsx/cjs --test src/app.test.ts src/auth.test.ts src/logic/simulateBattle.test.ts src/logic/inventorySlots.test.ts src/logic/request.test.ts src/services/battle.test.ts src/services/inventory.test.ts",
    "test:integration": "node --require tsx/cjs --test --test-concurrency=1 src/services/*.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@webgame/types": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "postgres": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "5.9.2"
  }
}
