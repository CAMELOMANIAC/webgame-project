// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  nickname  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stash               StashItem[]
  snapshots           GhostSnapshot[]
  characters          Character[]     @relation("OwnedCharacters")
  selectedCharacterId String?
  selectedCharacter   Character?      @relation("SelectedCharacter", fields: [selectedCharacterId], references: [id], onDelete: SetNull)
  storyTier           Int             @default(0)
  quests              QuestProgress[]
}

model CharacterDefinition {
  id       String             @id
  name     String
  variants CharacterVariant[]
}

model CharacterVariant {
  id            String              @id
  definitionId  String
  definition    CharacterDefinition @relation(fields: [definitionId], references: [id])
  worldlineCode String
  maxHp         Int                 @default(100)
  maxStamina    Int                 @default(100)
  staminaRegen  Int                 @default(10)
  maxWeight     Int                 @default(50)
  characters    Character[]

  @@unique([definitionId, worldlineCode])
}

model Character {
  id            String           @id @default(uuid())
  userId        String
  variantId     String           @default("legacy-origin")
  variant       CharacterVariant @relation(fields: [variantId], references: [id])
  displayName   String?
  createdAt     DateTime         @default(now())
  selectedBy    User[]           @relation("SelectedCharacter")
  hp            Int              @default(100)
  maxHp         Int              @default(100)
  stamina       Int              @default(100)
  maxStamina    Int              @default(100)
  staminaRegen  Int              @default(10)
  weight        Int              @default(0)
  maxWeight     Int              @default(50)
  time          Int              @default(0)
  isRaiding     Boolean          @default(false)
  currentNodeId Int              @default(0)
  activeRaidId  String?          @unique
  activeRaid    RaidSession?     @relation("ActiveRaid", fields: [activeRaidId], references: [id], onDelete: SetNull)
  raids         RaidSession[]    @relation("CharacterRaids")
  snapshots     GhostSnapshot[]

  user      User                @relation("OwnedCharacters", fields: [userId], references: [id])
  weapons   CharacterWeapon[]
  inventory RaidInventoryItem[]

  @@index([userId, createdAt])
}

model CharacterWeapon {
  id             String @id @default(uuid())
  characterId    String
  weaponMasterId String
  slotIndex      Int // 0~5

  character    Character    @relation(fields: [characterId], references: [id])
  weaponMaster WeaponMaster @relation(fields: [weaponMasterId], references: [id])

  @@unique([characterId, slotIndex])
}

model RaidInventoryItem {
  id             String @id @default(uuid())
  characterId    String
  weaponMasterId String
  quantity       Int    @default(1)
  slotIndex      Int // 0~31

  character    Character    @relation(fields: [characterId], references: [id])
  weaponMaster WeaponMaster @relation(fields: [weaponMasterId], references: [id])

  @@unique([characterId, slotIndex])
}

model WeaponMaster {
  id            String     @id @default(uuid())
  name          String
  damage        Int
  staminaCost   Int
  cooldownTicks Int
  castTicks     Int
  weight        Int
  value         Int
  description   String?
  attackType    AttackType @default(MELEE)
  iconKey       String     @default("WEAPON")
  effect        Json?

  stashItems     StashItem[]
  ghostWeapons   GhostWeapon[]
  charWeapons    CharacterWeapon[]
  raidInventory  RaidInventoryItem[]
  monsterWeapons MonsterWeapon[]
}

enum AttackType {
  MELEE
  RANGED
}

model MonsterMaster {
  id           String @id @default(uuid())
  name         String
  hp           Int
  maxHp        Int
  stamina      Int
  maxStamina   Int
  staminaRegen Int
  level        Int    @default(1)

  weapons MonsterWeapon[]
}

model MonsterWeapon {
  id             String @id @default(uuid())
  monsterId      String
  weaponMasterId String
  slotIndex      Int // 0~5 슬롯 인덱스

  monster      MonsterMaster @relation(fields: [monsterId], references: [id])
  weaponMaster WeaponMaster  @relation(fields: [weaponMasterId], references: [id])
}

model StashItem {
  id             String @id @default(uuid())
  userId         String
  weaponMasterId String
  quantity       Int    @default(1)

  user         User         @relation(fields: [userId], references: [id])
  weaponMaster WeaponMaster @relation(fields: [weaponMasterId], references: [id])
}

model GhostSnapshot {
  id            String       @id @default(uuid())
  userId        String
  nodeId        String // 필드 노드 ID
  time          Int // 이전 API 호환 필드. 새 기록에서는 round와 같은 값.
  hp            Int
  maxHp         Int
  stamina       Int
  maxStamina    Int
  staminaRegen  Int
  weight        Int
  maxWeight     Int
  createdAt     DateTime     @default(now())
  raidId        String?
  raid          RaidSession? @relation(fields: [raidId], references: [id], onDelete: SetNull)
  characterId   String?
  character     Character?   @relation(fields: [characterId], references: [id], onDelete: SetNull)
  round         Int          @default(0)
  rulesVersion  Int          @default(0)
  mapVersion    String       @default("seopo-prototype-1")
  combatant     Json?
  variantId     String?
  worldlineCode String?

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  weapons    GhostWeapon[]
  encounters RaidGhostEncounter[]

  @@unique([raidId, round, nodeId])
  @@index([nodeId, rulesVersion, round, createdAt])
}

model GhostWeapon {
  id             String @id @default(uuid())
  snapshotId     String
  weaponMasterId String
  slotIndex      Int // 0~5 슬롯 인덱스

  snapshot     GhostSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  weaponMaster WeaponMaster  @relation(fields: [weaponMasterId], references: [id])
}

enum RaidStatus {
  ACTIVE
  EXTRACTED
  DEAD
}

model RaidSession {
  id              String               @id @default(uuid())
  characterId     String
  character       Character            @relation("CharacterRaids", fields: [characterId], references: [id], onDelete: Cascade)
  activeCharacter Character?           @relation("ActiveRaid")
  status          RaidStatus           @default(ACTIVE)
  version         Int                  @default(0)
  currentNodeId   Int                  @default(0)
  round           Int                  @default(0)
  startedAt       DateTime             @default(now())
  mapVersion      String               @default("seopo-prototype-1")
  endedAt         DateTime?
  commands        RaidCommand[]
  snapshots       GhostSnapshot[]
  ghostEncounters RaidGhostEncounter[]
  recoveredQuests QuestProgress[]

  @@index([characterId, startedAt])
}

model RaidCommand {
  id          String      @id @default(uuid())
  raidId      String
  raid        RaidSession @relation(fields: [raidId], references: [id], onDelete: Cascade)
  requestId   String
  kind        String
  fingerprint String
  response    Json
  createdAt   DateTime    @default(now())

  @@unique([raidId, requestId])
}

model RaidGhostEncounter {
  raidId     String
  snapshotId String
  raid       RaidSession   @relation(fields: [raidId], references: [id], onDelete: Cascade)
  snapshot   GhostSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@id([raidId, snapshotId])
}

enum QuestStatus {
  ACTIVE
  RECOVERED
  READY
  COMPLETE
}

model QuestProgress {
  userId            String
  questId           String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  definitionVersion Int          @default(1)
  status            QuestStatus  @default(ACTIVE)
  recoveredRaidId   String?
  recoveredRaid     RaidSession? @relation(fields: [recoveredRaidId], references: [id], onDelete: SetNull)
  acceptedAt        DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  completedAt       DateTime?

  @@id([userId, questId])
}
